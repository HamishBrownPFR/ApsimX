                    "{",
                    "    [Serializable] ",
                    "    public class Script : Model",
                    "    {",
                    "        [Link] private Clock Clock;",
                    "        [Link] private Plant Wheat;",
                    "        public  event EventHandler LeafReport;",
                    "        [Link(Type = LinkType.Path, Path = \"[Wheat].Structure\")]",
                    "        private Structure structure;",
                    "        ",
                    "        ",
                    "        [JsonIgnore] public int LeafPosition { get; set; }",
                    "        [JsonIgnore] public double LeafSize { get; set; }",
                    "        [JsonIgnore] public double MaxLeafSize { get; set; }",
                    "        ",
                    "        [EventSubscribe(\"DoManagement\")]",
                    "        private void OnDoManagement(object sender, EventArgs e)",
                    "        {",
                    "            var leaf = Wheat.Leaf as Leaf;",
                    "            if ((leaf.ExpandedCohortNo > LeafPosition) & (structure.NextLeafProportion == 1))",
                    "            {",
                    "                LeafPosition = (int)leaf.ExpandedCohortNo;",
                    "                LeafSize = leaf.CohortSize[LeafPosition];",
                    "                MaxLeafSize = leaf.CohortMaxArea[LeafPosition];",
                    "                LeafReport.Invoke(this, new EventArgs());",
                    "            }",
                    "        }",
                    "    }",
                    "}"
                  ],
                  "Parameters": [],
                  "Name": "MaxLeafSize",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
