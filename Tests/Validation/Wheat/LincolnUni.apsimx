    {
      "$type": "Models.Factorial.Experiment, Models",
      "DisabledSimNames": [
        "Lincoln2023SD19-AprCvCesario",
        "Lincoln2023SD27-MarCvCesario",
        "Lincoln2023SD19-AprCvStockade",
        "Lincoln2023SD27-MarCvStockade"
      ],
      "Name": "Lincoln2024",
      "ResourceName": null,
      "Children": [
        {
          "$type": "Models.Memo, Models",
          "Text": "The purpose of this experiment is to test model predictions of canopy development, biomass accumulation and partition.  The cultivars used do not have sufficient data with different sowing dates to allow accurate fitting of phenology parameters.  However, detailed observtions of the timing of phenological stages were conducted for this experiment.  As such, the timing of phenology stages was set (using the SetModelParamsBySimulation model in the base simulation) to ensure good alignment of the models phenology with the experiment so model comparisons of biomass could be made without confunding of poor phenology predictions.",
          "Name": "Phenology Not modeled",
          "ResourceName": null,
          "Children": [],
          "Enabled": true,
          "ReadOnly": false
        },
        {
          "$type": "Models.Factorial.Factors, Models",
          "Name": "Factors",
          "ResourceName": null,
          "Children": [
            {
              "$type": "Models.Factorial.Permutation, Models",
              "Name": "Permutation",
              "ResourceName": null,
              "Children": [
                {
                  "$type": "Models.Factorial.Factor, Models",
                  "Specification": "",
                  "Name": "SD",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Factorial.CompositeFactor, Models",
                      "Specifications": [
                        "[Sowing].Script.SowDate = 20-Mar",
                        "[ApplyFertiliser].Script.FertiliserDates = 17-May,7-Aug, 27-Aug, 25-Oct",
                        "[IrrigationEvents]",
                        "[Clock].EndDate = 10-Jan-2025",
                        "[Sowing].Script.Population = 135"
                      ],
                      "CustomDescriptors": [],
                      "Name": "20Mar",
                      "ResourceName": null,
                      "Children": [
                        {
                          "$type": "Models.Operations, Models",
                          "OperationsList": [
                            {
                              "$type": "Models.Operation, Models",
                              "Enabled": true,
                              "Date": "2024-04-06",
                              "Action": "[Irrigation].Apply (12);",
                              "Line": "2024-04-06 [Irrigation].Apply (12);"
                            },
                            {
                              "$type": "Models.Operation, Models",
                              "Enabled": true,
                              "Date": "2024-05-06",
                              "Action": "[Irrigation].Apply (11);",
                              "Line": "2024-05-06 [Irrigation].Apply (11);"
                            },
                            {
                              "$type": "Models.Operation, Models",
                              "Enabled": true,
                              "Date": "2024-08-27",
                              "Action": "[Irrigation].Apply (5);",
                              "Line": "2024-08-27 [Irrigation].Apply (5);"
                            },
