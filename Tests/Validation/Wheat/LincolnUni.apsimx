            "//                LeafSize =   (double)Structure.Get(\"Wheat.Leaf.CohortSize[\"+((LeafPosition+1).ToString())+\"]\", relativeTo: thisZone);",
            "//                MaxLeafSize = (double)Structure.Get(\"Wheat.Leaf.CohortMaxArea[\"+((LeafPosition+1).ToString())+\"]\", relativeTo: thisZone);",
