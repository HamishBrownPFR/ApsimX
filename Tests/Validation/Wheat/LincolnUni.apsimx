                  "Name": "DoubleRidgeDAS",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Memo, Models",
                      "Text": "\nA function is used to provide DoubleRidge date as days after sowing(DAS).\n",
                      "Name": "memo",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
