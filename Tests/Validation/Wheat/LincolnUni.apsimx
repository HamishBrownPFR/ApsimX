                            "[Wheat].Grain.Number",
                            "[Wheat].Grain.N",
                            "[Wheat].Grain.NConc"
                          ],
                          "EventNames": [
                            "[Wheat].Harvesting"
                          ],
                          "GroupByVariableName": null,
                          "Name": "ProteinReport",
                          "ResourceName": null,
