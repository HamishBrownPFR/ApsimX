                        "        [Link] private ControlledEnvironment ci;",
                        "        [Link]",
                        "        private Phenology phenology;",
                        "",
                        "        [Display(Type = DisplayType.CultivarName)]",
                        "        [Description(\"Cultivar to be sown\")]",
                        "        public string CultivarName { get; set; }",
                        "        [Description(\"Sowing depth (mm)\")]",
                        "        public double SowingDepth { get; set; }",
                        "        [Description(\"Treatment duration (Days)\")]",
                        "        public double TransitionDay { get; set; }",
                        "        [Description(\"Max Initial temperature (oC)\")]",
                        "        public double InitTempMax { get; set; }",
                        "        [Description(\"Min Initial temperature (oC)\")]",
                        "        public double InitTempMin { get; set; }",
                        "        [Description(\"Init photoperiod (h)\")]",
                        "        public double InitPp { get; set; }",
                        "        [Description(\"Max Final temperature (oC)\")]",
                        "        public double FinalTempMax { get; set; }",
                        "        [Description(\"Min Final temperature (oC)\")]",
                        "        public double FinalTempMin { get; set; }",
                        "        [Description(\"Final photoperiod (h)\")]",
                        "        public double FinalPp { get; set; }",
                        "        private double DAS {get; set;}",
                        "        private bool FirstDay = true;",
                        "        private double Weeks {get; set;}",
                        "        private bool Transitioned = false;",
                        "        private bool Emerged = false;",
                        "",
                        "        [EventSubscribe(\"DoCatchYesterday\")]",
                        "        private void DoCatchYesterday(object sender, EventArgs e)",
                        "        {",
                        "            if (FirstDay)",
                        "            {",
                        "                ci.MaxT = InitTempMax;",
                        "                ci.MinT = InitTempMin;",
                        "                ci.DayLength = InitPp;",
                        "                ci.Radn = InitPp * 3600 * 0.000170 * 2; //Hours * s/h * MJ/m2/s * Coeff_PAR->Total ",
                        "                lentil.Sow(population: 100, cultivar: CultivarName, depth: SowingDepth, rowSpacing: 150);    ",
                        "                FirstDay = false;",
                        "                summary.WriteMessage(this,\"Wheat crop sown\", MessageType.Diagnostic);",
                        "            }",
                        "",
                        "            DAS += 1;",
                        "            if (DAS <= TransitionDay)",
                        "            {",
                        "                ci.MaxT = InitTempMax;",
                        "                ci.MinT = InitTempMin;",
                        "                ci.DayLength = InitPp;",
                        "                ci.Radn = InitPp * 3600 * 0.000170 * 2; //Hours * s/h * MJ/m2/s * Coeff_PAR->Total ",
                        "            }",
                        "            else",
                        "            {",
                        "                if ((DAS >= TransitionDay)&&(Transitioned = false))",
                        "                {",
                        "                    Transitioned = true;",
                        "                    summary.WriteMessage(this,\"Plants moved to post treatment chamber\", MessageType.Diagnostic);",
                        "                }",
                        "                ci.MaxT=FinalTempMax;",
                        "                ci.MinT=FinalTempMin;",
                        "                ci.DayLength = FinalPp;",
                        "                ci.Radn = FinalPp * 3600 * 0.000170 * 2; //Hours * s/h * MJ/m2/s * Coeff_PAR->Total ",
                        "            }",
                        "        }",
                        "    }",
                        "}"
                      ],
                      "Parameters": [
                        {
                          "Key": "CultivarName",
                          "Value": "Ace"
                        },
                        {
                          "Key": "SowingDepth",
                          "Value": "20"
                        },
                        {
                          "Key": "TransitionDay",
                          "Value": "0"
                        },
                        {
                          "Key": "InitTempMax",
                          "Value": "0"
                        },
                        {
                          "Key": "InitTempMin",
                          "Value": "0"
                        },
                        {
                          "Key": "InitPp",
                          "Value": "0"
                        },
                        {
                          "Key": "FinalTempMax",
                          "Value": "0"
                        },
                        {
                          "Key": "FinalTempMin",
                          "Value": "0"
                        },
                        {
                          "Key": "FinalPp",
                          "Value": "0"
                        }
