    {
      "$type": "Models.Factorial.Experiment, Models",
      "DisabledSimNames": null,
      "Name": "Emerald19",
      "ResourceName": null,
      "Children": [
        {
          "$type": "Models.Factorial.Factors, Models",
          "Name": "Factors",
          "ResourceName": null,
          "Children": [
            {
              "$type": "Models.Memo, Models",
              "Text": "**Factors at Emerald**\n\n***Time of sowing***\n\n1. 10 May, 2019  \n2. 3 June, 2019  \n3. 27 June, 2019\n\n\n***Cultivar***  \n\n***PBA Bolt*** - this cultivar was not part of the original experiment design but was sown in the filler rows in a way consistent with sowings of the other cultivars that formed part of the experiment. The reliability of the data for *should* be the same as for the other cultivars but should also be evaluated in light of this information.  \nPBA Ace  \nPBA Blitz  \nPBA Greenfield  \nPBA Hallmark XT  \nPBA Jumbo  \n\n\n\nMay 10 plant – lentil emerged 16/5 ; chickpeas emerged about 19/5\nJune 3 plant – lentil emerged about 12-13/6 ; chickpeas emerged about 15/6\nJune 27 plant – lentil emerged about 7-8/7 ; chickpeas emerged 9-10/7\n\nI don’t recall if the desi and kabuli have different emergence dates but the lentil was fast and was always the first to emerge. Lentil seems to have plenty of vigour. If there were emergence differences between the chickpeas, it was minor.\n",
              "Name": "Memo",
              "ResourceName": null,
              "Children": [],
              "Enabled": true,
              "ReadOnly": false
            },
            {
              "$type": "Models.Factorial.Permutation, Models",
              "Name": "Permutation",
              "ResourceName": null,
              "Children": [
                {
                  "$type": "Models.Factorial.Factor, Models",
                  "Specification": "",
                  "Name": "TOS",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Factorial.CompositeFactor, Models",
                      "Specifications": [
                        "[Sowing].Script.SowDate = 10-May",
                        "[Reset on date]",
                        "[Water].Thickness=150,150,300,300,300,300,300",
                        "[Water].InitialValues=0.366,0.369,0.378,0.329,0.338,0.326,0.326"
                      ],
                      "CustomDescriptors": [],
                      "Name": "1",
                      "ResourceName": null,
                      "Children": [
                        {
                          "$type": "Models.Manager, Models",
                          "CodeArray": [
                            "using Models.Interfaces;",
                            "using System;",
                            "using Models.Core;",
                            "using Models.PMF;",
                            "using Models.Soils;",
                            "using Models.Utilities;",
                            "using Models.Surface;",
                            "using APSIM.Shared.Utilities;",
                            "",
                            "namespace Models",
                            "{",
                            "    [Serializable]",
                            "    public class Script : Model",
                            "    {",
                            "        [Link] private Clock Clock;",
                            "        [Link] private Plant Wheat;",
                            "        [Link] private ISoilWater SoilWater;",
                            "        [Link] private SurfaceOrganicMatter SOM;",
                            "        [Link] private Summary Summary;",
                            "",
                            "        [Description(\"Date to reset on:\")]",
                            "        public string ResetDate {get;set;}",
                            "",
                            "        [Description(\"Reset Water? (Yes or No)\")]",
                            "        public string ResetWater {get;set;}",
                            "",
                            "        [Description(\"Reset Surface Organic Matter? (Yes or No)\")]",
                            "        public string ResetSOM {get;set;}",
                            "",
                            "        [EventSubscribe(\"DoManagement\")]",
                            "        private void OnDoManagement(object sender, EventArgs e)",
                            "        {",
                            "            if (DateUtilities.WithinDates(ResetDate, Clock.Today, ResetDate))",
                            "            {",
                            "                if (ResetWater == \"Yes\")",
                            "                {",
                            "                    Summary.WriteMessage(this, \"Reset Water\", MessageType.Diagnostic);",
                            "                    SoilWater.Reset();",
                            "                }",
                            "                if (ResetSOM == \"Yes\")",
                            "                {",
                            "                    Summary.WriteMessage(this, \"Reset Surface OM\", MessageType.Diagnostic);",
                            "                    SOM.Reset();",
                            "                }",
                            "            }",
                            "        }",
                            "    }",
                            "}"
                          ],
                          "Parameters": [
                            {
                              "Key": "ResetDate",
                              "Value": "14-May"
                            },
                            {
                              "Key": "ResetWater",
                              "Value": "Yes"
                            },
                            {
                              "Key": "ResetSOM",
                              "Value": "No"
                            }
                          ],
                          "Name": "Reset on date",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        }
                      ],
                      "Enabled": true,
                      "ReadOnly": false
                    },
