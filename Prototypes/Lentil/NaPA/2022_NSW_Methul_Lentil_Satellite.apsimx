                {
                  "$type": "Models.Manager, Models",
                  "CodeArray": [
                    "using APSIM.Shared.Utilities;",
                    "using Models.Utilities;",
                    "using Models.Soils;",
                    "using Models.PMF;",
                    "using Models.Core;",
                    "using System;",
                    "",
                    "namespace Models",
                    "{",
                    "    [Serializable]",
                    "    public class Script : Model",
                    "    {",
                    "        [Link] Clock Clock;",
                    "        [Link] Fertiliser Fertiliser;",
                    "        [Link] Summary Summary;",
                    "        [Link] Plant Lentil;",
                    "        [Link] Soil Soil;",
                    "        Accumulator accumulatedRain;",
                    "        ",
                    "        [Description(\"Sowing date (d-mmm)\")]",
                    "        public string SowDate { get; set; }",
                    "        [Description(\"Emergence date (d-mmm)\")]",
                    "        public string EmergeDate { get; set; }",
                    "        [Description(\"Cultivar to be sown\")]",
                    "        public string CultivarName { get; set; }",
                    "        [Description(\"Sowing depth (mm)\")]",
                    "        public double SowingDepth { get; set; }",
                    "        [Description(\"Row spacing (mm)\")]",
                    "        public double RowSpacing { get; set; }",
                    "        [Description(\"Plant population (/m2)\")]",
                    "        public double Population { get; set; }",
                    "        [Description(\"Population Modifier (0-)\")]",
                    "        public string TrtName { get; set; }",
                    "        ",
                    "        ",
                    "",
                    "",
                    "        [EventSubscribe(\"DoManagement\")]",
                    "        private void OnDoManagement(object sender, EventArgs e)",
                    "        {",
                    "            if (DateUtilities.WithinDates(SowDate, Clock.Today, SowDate))",
                    "            {",
                    "                double estPopn = Population;",
                    "                if (TrtName == \"Density_0.66\")",
                    "                    estPopn = Population * 0.66;",
                    "                Lentil.Sow(population: estPopn  , cultivar: CultivarName, depth: SowingDepth, rowSpacing: RowSpacing);    ",
                    "                if (EmergeDate != \"\")",
                    "                Lentil.Phenology.SetPhaseCompletionDate(EmergeDate,\"Emerging\");",
                    "            }",
                    "        }",
                    "    }",
                    "}"
                  ],
                  "Parameters": [
                    {
                      "Key": "SowDate",
                      "Value": ""
                    },
                    {
                      "Key": "EmergeDate",
                      "Value": ""
                    },
                    {
                      "Key": "CultivarName",
                      "Value": ""
                    },
                    {
                      "Key": "SowingDepth",
                      "Value": "30"
                    },
                    {
                      "Key": "RowSpacing",
                      "Value": "380"
                    },
                    {
                      "Key": "Population",
                      "Value": "25"
                    },
                    {
                      "Key": "TrtName",
                      "Value": ""
                    }
                  ],
                  "Name": "Sowing",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
