                },
                {
                  "$type": "Models.Manager, Models",
                  "CodeArray": [
                    "using Models.Soils;",
                    "using System;",
                    "using System.Linq;",
                    "using Models.Core;",
                    "using Models.PMF;",
                    "using APSIM.Shared.Utilities;",
                    "using System.Globalization;",
                    "using System.Text.RegularExpressions;",
                    "",
                    "namespace Models",
                    "{",
                    "    [Serializable]",
                    "    public class Script : Model",
                    "    {",
                    "        [Link] Clock Clock;",
                    "        [Link] Fertiliser Fertiliser;",
                    "        ",
                    "        [Separator(\"A component to apply fertiliser on one or more dates on every year of the simulation\")]",
                    "",
                    "        [Description(\"Type of fertiliser to apply? \")] ",
                    "        [Display(Type = DisplayType.FertiliserType)]public string FertiliserType { get; set; }",
                    "",
                    "        [Description(\"Dates to apply fertiliser \")] ",
                    "        public string[] FertiliserDates { get; set; } ",
                    "",
                    "        [Description(\"Amount of fertiliser to be applied (kg /ha)\")] ",
                    "        public string TrtName { get; set; }",
                    "        ",
                    "        double applicationN = 0;",
                    "        ",
                    "        [EventSubscribe(\"StartOfSimulation\")]",
                    "        private void OnSimulationCommencing(object sender, EventArgs e)",
                    "        {",
                    "            if (TrtName != \"none\")",
                    "            {",
                    "                int splits = FertiliserDates.Count();",
                    "                string numericPart = new string(TrtName.Where(c => char.IsDigit(c) || c == '.').ToArray());",
                    "                double TotalN = double.Parse(numericPart, CultureInfo.InvariantCulture);",
                    "                double applicationN = TotalN/splits;",
                    "            }",
                    "        }    ",
                    "        ",
                    "        [EventSubscribe(\"DoManagement\")]",
                    "        private void OnDoManagement(object sender, EventArgs e)",
                    "        {",
                    "            foreach (string ddMMM in FertiliserDates)",
                    "            {",
                    "                if (DateUtilities.DatesEqual(ddMMM, Clock.Today))",
                    "                {",
                    "                   Fertiliser.Apply(amount: applicationN, type: FertiliserType);",
                    "                }",
                    "            }",
                    "        }",
                    "    }",
                    "}"
                  ],
                  "Parameters": [
                    {
                      "Key": "FertiliserType",
                      "Value": "UreaN"
                    },
                    {
                      "Key": "FertiliserDates",
                      "Value": "14/06/2022"
                    },
                    {
                      "Key": "TrtName",
                      "Value": "0kgN"
                    }
                  ],
                  "Name": "ApplyFertiliser",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Manager, Models",
                  "CodeArray": [
                    "using Models.Soils;",
