                    "[Lentil].SowingDate.Date as Lentil_SowingDate",
                    "[Lentil].Phenology.EmergenceDAS as Lentil_EmergenceDAS",
                    "[Lentil].Phenology.StartBuddingDAS as Lentil_BuddingDAS",
