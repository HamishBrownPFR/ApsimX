            {
              "$type": "Models.Climate.Weather, Models",
              "ConstantsFile": null,
              "FileName": "NSW_RankinsSprings.met",
              "ExcelWorkSheetName": "",
              "Name": "Weather",
              "ResourceName": null,
              "Children": [],
