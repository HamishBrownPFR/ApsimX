                },
                {
                  "$type": "Models.Manager, Models",
                  "CodeArray": [
                    "using System;",
                    "using System.Data;",
                    "using System.Collections.Generic;",
                    "using System.Linq;",
                    "using System.IO;",
                    "using APSIM.Core;",
                    "using APSIM.Shared.Utilities;",
                    "using Models.Climate;",
                    "using Models.Core;",
                    "using Models.Functions;",
                    "using Models.PMF;",
                    "using Models.Soils;",
                    "using Models.Utilities;",
                    "",
                    "namespace Models",
                    "{",
                    "    [Serializable]",
                    "    public class Script : Model, IStructureDependency",
                    "    {",
                    "        [Link] private Simulation simulation;",
                    "        [Link] private Clock Clock;",
                    "        [Link] private Fertiliser Fertiliser;",
                    "        [Link] private Summary Summary;",
                    "        [Link] private Soil Soil;",
                    "        [Link] private Water Water;",
                    "        [Link] private Operations Operations;",
                    "        [Link] private Weather Weather;",
                    "        private IPlant plant;",
                    "        private IFunction buddingDAS;",
                    "        private IFunction poddingDAS;",
                    "        private IFunction floweringDAS;",
                    "        private IFunction maturityDAS;",
                    "        [Link(ByName=true)] private Report HarvestReport;",
                    "        [Link(ByName=true)] private Report DevelReport;",
                    "        [Link(ByName=true)] private Report SoilReport;",
                    "        private int layer800mm;",
                    "        private Accumulator accumulatedRain;",
                    "        ",
                    "        public IStructure Structure { private get; set; }",
                    "        ",
                    "        private IEnumerable<IModelCommand> commands;",
                    "        ",
                    "        private double [] cropLL;",
                    "        private double [] DUL;",
                    "        private double [] Thickness;",
                    "        private List<DateTime> dates = new List<DateTime>();",
                    "",
                    "        [Description(\"Index table of experiment\")]",
                    "        public string csvFile { get; set; }",
                    "",
                    "        [Description(\"Experimental Year ()\")]",
                    "        public string EYear { get; set; }",
                    "        ",
                    "        [Description(\"State ()\")]",
                    "        public string State { get; set; }",
                    "        ",
                    "        [Description(\"Site ()\")]",
                    "        public string Site { get; set; }",
                    "",
                    "        [Description(\"TrialType ()\")]",
                    "        public string TrialType { get; set; }",
                    "                                                ",
                    "        [Description(\"Crop ()\")]",
                    "        public string Crop { get; set; }",
                    "                        ",
                    "        [Description(\"Time of Sowing (TOS1,2,3)\")]",
                    "        public string TOS { get; set; }",
                    "        ",
                    "        [Description(\"Cultivar to be sown\")]",
                    "        public string Variety { get; set; }",
                    "         ",
                    "        [Description(\"Water treatment\")]",
                    "        public string WaterTrt { get; set; }",
                    "",
                    "        [Description(\"Replicate\")]",
                    "        public int Replicate { get; set; }",
                    "",
                    "        [Description(\"Agronomy treatment\")]",
                    "        public string AgronomyTrt { get; set; }",
                    "",
                    "         ",
                    "        [Description(\"Sowing depth (mm)\")]",
                    "        public double SowingDepth { get; set; }",
                    "        ",
                    "        [Description(\"Row spacing (mm)\")]",
                    "        public string RowSpacing { get; set; }",
                    "        ",
                    "        [Description(\"Plant population (/m2)\")]",
                    "        public double Population { get; set; }",
                    "        ",
                    "        [Description(\"Sowing Date (dd-mmm)\")]",
                    "        public string SowDate {get; set;}",
                    "",
                    "        [Description(\"Use Standard Cultivars ()\")]",
                    "        public bool UseStandardCultivars {get; set;}",
                    "",
                    "        public string ID {get; set;}",
                    "",
                    "        public string ymd {get {",
                    "          return \"d\" + Clock.Today.ToString(\"yyyy-MM-dd\");",
                    "        } set;}",
                    "        ",
                    "        [EventSubscribe(\"StartOfSimulation\")]",
                    "        private void OnSimulationCommencing(object sender, EventArgs e)",
                    "        {",
                    "           if (Crop.Contains(\",\")) {",
                    "               Crop = \"Mixed\"; ",
                    "           } ",
                    "           ID = (EYear + \"_\" + State + \"_\" + Site + \"_\" + Crop + \"_\" + TrialType + \"_\" + TOS + \"_\" + Variety + \"_\" + WaterTrt).ToString().ToLower();",
                    "           if (AgronomyTrt != \"None\") ",
                    "             ID += \"_\" + AgronomyTrt.ToLower();",
                    "",
                    "           // mixed experiments determine crop type from variety",
                    "           if (Crop == \"Mixed\") {   ",
                    "              // print(experiments[experiments$Crop==\"Mixed\",c(\"Variety\", \"MixedCropType\")] %>%unique(), n=25)",
                    "              var cropVarieties = new Dictionary<string, string>() {",
                    "{\"PBA_Ace\" , \"Lentil\"},",
                    "{\"PBA_Jumbo2\" , \"Lentil\"},",
                    "{\"PBA_Blitz\" , \"Lentil\"},",
                    "{\"PBA_KelpieXT\" , \"Lentil\"},",
                    "{\"PBA_HatTrick\" , \"Chickpea\"},",
                    "{\"PBA_Slasher\" , \"Chickpea\"},",
                    "{\"Genesis_090\" , \"Chickpea\"},",
                    "{\"PBA_Monarch\" , \"Chickpea\"},",
                    "{\"PBA_Drummond\" , \"Chickpea\"},",
                    "{\"CBA_Captain\" , \"Chickpea\"},",
                    "{\"PBA_Striker\" , \"Chickpea\"},",
                    "{\"PBA_Samira\" , \"Fababean\"},",
                    "{\"PBA_Marne\" , \"Fababean\"},",
                    "{\"PBA_Amberley\" , \"Fababean\"},",
                    "{\"PBA_Nasma\" , \"Fababean\"},",
                    "{\"Jindalee\" , \"Lupin\"},",
                    "{\"Wonga\" , \"Lupin\"},",
                    "{\"PBA_Bateman\" , \"Lupin\"},",
                    "{\"PBA_Jurien\" , \"Lupin\"}",
                    "// not for now {\"Canola\" , \"Canola\"},",
                    "}; ",
                    "               if (!cropVarieties.ContainsKey(Variety)) {",
                    "                 throw new Exception(\"Don't know what crop to use for variety \\\"\" + Variety + \"\\\"\");",
                    "               }",
                    "               Crop = cropVarieties[Variety];",
                    "           }",
                    "           ",
                    "           if (UseStandardCultivars) {",
                    "              Variety = Variety.",
                    "                 Replace(\"PBA_\", \"\"). ",
                    "                 Replace(\"CBA_\", \"\"). ",
                    "                 Replace(\"Genesis_090\", \"Genesis90\"); ",
                    "           }",
                    "",
                    "           plant =   Structure.FindChild<IModel>(Crop, recurse: true, relativeTo: (INodeModel)simulation) as IPlant;",
                    "           if (plant == null) { throw new Exception(\"Cant find crop component \\\"\" + Crop +\"\\\"\"); }",
                    "             ",
                    "           buddingDAS =   Structure.FindChild<IModel>(\"StartBuddingDAS\", recurse: true, relativeTo: (INodeModel)plant) as IFunction;",
                    "           poddingDAS =   Structure.FindChild<IModel>(\"StartPoddingDAS\", recurse: true, relativeTo: (INodeModel)plant) as IFunction;",
                    "           floweringDAS =   Structure.FindChild<IModel>(\"StartFloweringDAS\", recurse: true, relativeTo: (INodeModel)plant) as IFunction;",
                    "           maturityDAS =   Structure.FindChild<IModel>(\"MaturityDAS\", recurse: true, relativeTo: (INodeModel)plant) as IFunction;",
                    "           ",
                    "           // Ensure filename is relative to the directory where the .apsimx file is located.",
                    "           string fullFileName = PathUtilities.GetAbsolutePath(csvFile, simulation.FileName);",
                    "           ",
                    "           // Read in data.",
                    "           var data = readCSV(fullFileName, ID);",
                    "",
                    "           var cmdCol = data.Columns.IndexOf(\"command\");",
                    "           if (cmdCol < 0) {throw new Exception(\"Missing 'command' column\");}",
                    "",
                    "           var dateCol = data.Columns.IndexOf(\"date\");",
                    "           if (dateCol < 0) {throw new Exception(\"Missing 'date' column\");}",
                    "",
                    "           if (Operations.OperationsList == null)",
                    "                Operations.OperationsList = new List<Operation>();",
                    "                ",
                    "           var myInitCommands = new List<String>();",
                    "           foreach (DataRow row in data.Rows) { ",
                    "              if (row[dateCol].ToString() == \"init\") {",
                    "                  myInitCommands.Add(row[cmdCol].ToString());",
                    "              } else {",
                    "                  var op = new Operation{Date = row[dateCol].ToString(), Action = row[cmdCol].ToString(), Enabled = true};",
                    "                  Operations.OperationsList.Add(op);",
                    "              }",
                    "           }",
                    "           //if (SowDate.ToLower() == \"na\") {",
                    "           //     Summary.WriteMessage(this, \"No Sowing date for '\" + myID + \"'\", MessageType.Information);",
                    "           //     Clock.EndDate = Clock.StartDate;",
                    "           //} else ",
                    "           if (myInitCommands.Count <= 0) {",
                    "                Summary.WriteMessage(this, \"No initial commands for '\" + ID + \"'\", MessageType.Information);",
                    "                Clock.EndDate = Clock.StartDate;",
                    "           } else {",
                    "                Summary.WriteMessage(this, \"Doing initialisation (key = '\" + ID + \"')\\n\" +",
                    "                                     string.Join(\"\\n\", myInitCommands), MessageType.Information);",
                    "                commands = CommandLanguage.StringToCommands(myInitCommands.ToArray(), ",
                    "                               relativeTo: Parent as INodeModel, relativeToDirectory: null);",
                    "                CommandProcessor.Run(commands, relativeTo: Parent as INodeModel, runner: null);",
                    "           }",
                    "           ",
                    "           AgronomyTrt = AgronomyTrt.ToLower();",
                    "           if (AgronomyTrt != \"none\")",
                    "           {",
                    "               if (AgronomyTrt == \"density_1\")",
                    "                  Population = 1 * Population;",
                    "               else if (AgronomyTrt == \"density_0.66\") ",
                    "                  Population = 0.66 * Population;",
                    "               else if (AgronomyTrt == \"natural\" ) ",
                    "                   /* nothing to do */ ;",
                    "               else if (AgronomyTrt == \"16_hr\" ) ",
                    "                   /* nothing to do (yet) */ ;",
                    "               else if (AgronomyTrt == \"50kgn\" || AgronomyTrt == \"125kgn\" || AgronomyTrt == \"175kgn\" || AgronomyTrt == \"350kgn\") { ",
                    "                   string amount = string.Join(\",\", new string(AgronomyTrt",
                    "                      .Where(c => char.IsBetween(c, '0', '9'))",
                    "                      .ToArray()).Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries)); ",
                    "                  //string amount = AgronomyTrt.Trim().TakeWhile(c => (\"0123456789\").Contains(c)).ToString(); ",
                    "                  var op = new Operation{Date = SowDate, Action = \"[Fertiliser].Apply(\" + amount + \",\\\"NO3N\\\")\", Enabled = true};",
                    "                  Operations.OperationsList.Add(op);",
                    "               } else {",
                    "                  throw new Exception(\"Unknown Agronomy treatment \\\"\" + AgronomyTrt + \"\\\"\");",
                    "               }",
                    "           }",
                    "           ",
                    "           var SoilCrop =   Structure.FindChild<SoilCrop>(plant.Name + \"Soil\", recurse: true, relativeTo: (INodeModel)Soil);",
                    "           if (SoilCrop == null) { throw new Exception(\"No \" + plant.Name + \"Soil found\"); }",
                    "           cropLL = SoilCrop.LL;",
                    "           ",
                    "           var Physical =   Structure.FindChild<Physical>(relativeTo: (INodeModel)Soil);    ",
                    "           DUL = Physical.DUL;",
                    "           Thickness = Physical.Thickness; ",
                    "           layer800mm = SoilUtilities.LayerIndexOfDepth(Thickness, 800);",
                    "        ",
                    "           hasFinishedNormally = false;",
                    "        }",
                    "        ",
                    "        [Units(\"mm rel WP\")]",
                    "        public double PAW_800mm {",
                    "          get {",
                    "            if (cropLL == null) return 0;",
                    "            double swTot = 0; double dep = 0;",
                    "            double[] sw = Water.Volumetric;",
                    "            for (var i = 0; i < layer800mm; i++) {",
                    "               dep += Thickness[i];",
                    "               double frac = 1;",
                    "               if (dep > 800) {",
                    "                  var top = dep - Thickness[i]; // depth of previous layer",
                    "                  frac = Math.Min(1, Math.Max(0, (800 - top) / Thickness[i])); // fraction of this layer used for 800mm depth ",
                    "               }  ",
                    "               swTot += frac * Math.Max((sw[i] - cropLL[i]) * Thickness[i], 0);",
                    "            }",
                    "            return(swTot);         ",
                    "          }",
                    "          set { }",
                    "        }",
                    "        ",
                    "        [Units(\"mm rel WP\")]",
                    "        public double ESWTot {",
                    "          get {",
                    "            if (cropLL == null) return 0;",
                    "            double swTot = 0;",
                    "            double[] sw = Water.Volumetric;",
                    "            for (var i = 0; i < sw.Length; i++) {",
                    "               swTot += Math.Max((sw[i] - cropLL[i]) * Thickness[i], 0);",
                    "            }",
                    "            return(swTot);         ",
                    "          }",
                    "          set { }",
                    "        }  ",
                    "",
                    "        private bool hasReportedDevelToday = false;",
                    "  ",
                    "        [EventSubscribe(\"DoManagement\")]",
                    "        private void OnDoManagement(object sender, EventArgs e)",
                    "        {",
                    "            hasReportedDevelToday = false;",
                    "            if (SowDate.ToLower() != \"na\" && DateUtilities.DatesEqual(SowDate, Clock.Today))",
                    "            {",
                    "                double RowSpacing_dbl; // mm",
                    "                if (! Double.TryParse(RowSpacing, out RowSpacing_dbl)) {",
                    "                   RowSpacing_dbl = 300;",
                    "                } ",
                    "                plant.Sow(population: Population, cultivar: Variety, depth: SowingDepth, rowSpacing: RowSpacing_dbl);",
                    "                //doReport(\"Sowing\");    ",
                    "            }",
                    "            ",
                    "            if (plant.IsReadyForHarvesting) {",
                    "                hasFinishedNormally = true;",
                    "                HarvestReport.DoOutput();",
                    "                //doReport(\"Harvest\");    ",
                    "                plant.Harvest();",
                    "                plant.EndCrop();",
                    "            }",
                    "        }",
                    " ",
                    "        [EventSubscribe(\"PreparingNewWeatherData\")] private void OnPreparingNewWeatherData(object sender, EventArgs e)",
                    "        {",
                    "            if (AgronomyTrt == \"16_hr\")",
                    "            {",
                    "                Weather.DayLength = 16;",
                    "            }",
                    "        }",
                    "       ",
                    "        public bool hasFinishedNormally {get; set;} ",
                    "        ",
                    "        [EventSubscribe(\"EndOfSimulation\")]",
                    "        private void OnEndOfSimulation(object sender, EventArgs e)",
                    "        {",
                    "            if (plant.IsAlive)",
                    "            {",
                    "                HarvestReport.DoOutput();",
                    "                plant.Harvest();",
                    "                plant.EndCrop();",
                    "            }",
                    "            ",
                    "            if (commands != null)",
                    "            {",
                    "                foreach (SetPropertyCommand command in commands)",
                    "                    command.Undo();",
                    "                commands = null;",
                    "            }",
                    "        }",
                    "        ",
                    "        private bool hasBudded = false;",
                    "        private bool hasPodded = false;",
                    "        private bool hasFlowered = false;",
                    "        private bool hasMatured = false;",
                    "        ",
                    "        public string Event {get; set; }",
                    "        public void doReport(string _event) ",
                    "        {  ",
                    "           if (!hasReportedDevelToday) {",
                    "              Event = _event;",
                    "              DevelReport.DoOutput();",
                    "              hasReportedDevelToday = true;",
                    "           }",
                    "        }",
                    "        ",
                    "        private DataTable readCSV(string strFilePath, string id)",
                    "        {",
                    "            DataTable dt = new DataTable();",
                    "            using (StreamReader sr = new StreamReader(strFilePath))",
                    "            {",
                    "                List<string> headers = SplitStringHonouringQuotes(sr.ReadLine(), \",\");;",
                    "                for (var i = 0; i < headers.Count; i++) { ",
                    "                   headers[i] = headers[i].Replace(\"\\\"\", \"\").ToLower(); ",
                    "                   dt.Columns.Add(headers[i]);",
                    "                }",
                    "                var idCol = dt.Columns.IndexOf(\"id\");",
                    "                if (idCol < 0) {throw new Exception(\"Missing 'id' column\");}",
                    "           ",
                    "                while (!sr.EndOfStream)",
                    "                {",
                    "                    List<string>rows = SplitStringHonouringQuotes(sr.ReadLine(), \",\");",
                    "                    if (rows[idCol].ToLower() == id) {",
                    "                       DataRow dr = dt.NewRow();",
                    "                       //Summary.WriteMessage(this, \"id='\" + id + \"'\" , MessageType.Information);",
                    "                       for (int i = 0; i < rows.Count; i++) {",
                    "                          dr[i] = rows[i].Replace(\"\\\"\", \"\");",
                    "                          //Summary.WriteMessage(this, headers[i] + \"='\" + dr[i] + \"'\" , MessageType.Information);",
                    "                       }",
                    "                       dt.Rows.Add(dr);",
                    "                    }",
                    "                }",
                    "            }",
                    "            return dt;",
                    "        }",
                    "        /// <summary>",
                    "        /// This method splits values on a comma but also honours double quotes",
                    "        /// ensuring something in double quotes is never split.",
                    "        ///     eg: if text = value1, \"value 2, 2a\", value3",
                    "        ///     then: words[0] = value1",
                    "        ///           words[1] = value2, 2a",
                    "        ///           words[2] = value3",
                    "        /// All values returned have been trimmed of spaces and double quotes.",
                    "        /// </summary>",
                    "        public List<string> SplitStringHonouringQuotes(string text, string delimiters)",
                    "        {",
                    "            List<string> ReturnStrings = new List<string>();",
                    "            if (text.Trim() == \"\")",
                    "                return ReturnStrings;",
                    "",
                    "            bool InsideQuotes = false;",
                    "            int Start = IndexNotOfAny(text, \" \".ToCharArray());",
                    "            for (int i = Start; i < text.Length; i++)",
                    "            {",
                    "                if (text[i] == '\"')",
                    "                    InsideQuotes = !InsideQuotes; // toggle",
                    "",
                    "                else if (!InsideQuotes)",
                    "                {",
                    "                    if (delimiters.IndexOf(text[i]) != -1)",
                    "                    {",
                    "                        // Found a word - store it.",
                    "                        if (Start != i)",
                    "                            ReturnStrings.Add(text.Substring(Start, i - Start).Trim(\" \".ToCharArray()));",
                    "                        Start = i+1;",
                    "",
                    "                    }",
                    "                }",
                    "            }",
                    "            if (Start != text.Length)",
                    "                ReturnStrings.Add(text.Substring(Start, text.Length - Start).Trim(\" \".ToCharArray()));",
                    "",
                    "            // remove leading and trailing quote if necessary.",
                    "            for (int i = 0; i < ReturnStrings.Count; i++)",
                    "            {",
                    "                if (ReturnStrings[i][0] == '\"' && ReturnStrings[i][ReturnStrings[i].Length - 1] == '\"')",
                    "                {",
                    "                    ReturnStrings[i] = ReturnStrings[i].Substring(1, ReturnStrings[i].Length - 2).Trim();",
                    "                    if (ReturnStrings[i] == \"\")",
                    "                    {",
                    "                        ReturnStrings.RemoveAt(i);",
                    "                        i--;",
                    "                    }",
                    "                }",
                    "            }",
                    "            return ReturnStrings;",
                    "        }",
                    "        public int IndexNotOfAny(string text, char[] delimiters)",
                    "        {",
                    "            return IndexNotOfAny(text, delimiters, 0);",
                    "        }",
                    "",
                    "        /// <summary>",
                    "        /// This method complements the string function IndexOfAny by",
                    "        /// providing a NOT version. Returns -1 if non of the specified",
                    "        /// characters are found in specified string.",
                    "        /// </summary>",
                    "        public int IndexNotOfAny(string text, char[] delimiters, int pos)",
                    "        {",
                    "            string DelimitersString = new string(delimiters);",
                    "            for (int i = pos; i < text.Length; i++)",
                    "            {",
                    "                if (DelimitersString.IndexOf(text[i]) == -1)",
                    "                    return i;",
                    "            }",
                    "            return -1;",
                    "        }",
                    "  }",
                    "}"
                  ],
                  "Parameters": [
                    {
                      "Key": "csvFile",
                      "Value": "2022_NSW_Methul_Lentil_Satellite.startingConditions.csv"
                    },
                    {
                      "Key": "EYear",
                      "Value": "2022"
                    },
                    {
                      "Key": "State",
                      "Value": "NSW"
                    },
                    {
                      "Key": "Site",
                      "Value": "Methul"
                    },
                    {
                      "Key": "TrialType",
                      "Value": "Satellite"
                    },
                    {
                      "Key": "Crop",
                      "Value": "Lentil"
                    },
                    {
                      "Key": "TOS",
                      "Value": "TOS1"
                    },
                    {
                      "Key": "Variety",
                      "Value": ""
                    },
                    {
                      "Key": "WaterTrt",
                      "Value": ""
                    },
                    {
                      "Key": "Replicate",
                      "Value": "0"
                    },
                    {
                      "Key": "AgronomyTrt",
                      "Value": "None"
                    },
                    {
                      "Key": "SowingDepth",
                      "Value": "30"
                    },
                    {
                      "Key": "RowSpacing",
                      "Value": "300"
                    },
                    {
                      "Key": "Population",
                      "Value": "25"
                    },
                    {
                      "Key": "SowDate",
                      "Value": "na"
                    },
                    {
                      "Key": "UseStandardCultivars",
                      "Value": "False"
                    }
