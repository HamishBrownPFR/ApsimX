            {
              "$type": "Models.Manager, Models",
              "CodeArray": [
                "using Models.Soils;",
                "using System.Diagnostics;",
                "using System.Collections.Generic;",
                "using System.IO;",
                "using System.Data;",
                "using System.Linq;",
                "using System;",
                "using Models.Interfaces;",
                "using Models.Core;",
                "using APSIM.Shared.Utilities;",
                "namespace Models",
                "{",
                "    [Serializable]",
                "    [System.Xml.Serialization.XmlInclude(typeof(Model))]",
                "    public class Script : Model",
                "    {",
                "        [Link] Clock clock;",
                "        [Link] IWeather weather;",
                "        [Link] Simulation simulation;",
                "        [Link] Summary Summary;",
                "        ",
                "        private DataTable data;",
                "        private List<DateTime> dates = new List<DateTime>();",
                "",
                "        private string patchFileName { get; set; }",
                "        ",
                "        [EventSubscribe(\"StartOfSimulation\")]",
                "        private void OnStartOfSimulation(object sender, EventArgs e)",
                "        {",
                "            //  Set local weather file path",
                "            patchFileName = \"Met\\\\Vic_Ouyen.logger.met\";",
                "        ",
                "            // Ensure filename is relative to the directory where the .apsimx file is located.",
                "            string fullFileName = PathUtilities.GetAbsolutePath(patchFileName, simulation.FileName);",
                "        ",
                "            // Read in data.",
                "            data = ApsimTextFile.ToTable(fullFileName);",
                "            foreach (DataRow row in data.Rows)",
                "                dates.Add(DataTableUtilities.GetDateFromRow(row));",
                "                ",
                "            if (! data.Columns.Contains(\"rain\") ||",
                "\t              ! data.Columns.Contains(\"radn\") ||",
                "\t              ! data.Columns.Contains(\"mint\") ||",
                "\t              ! data.Columns.Contains(\"maxt\")) {",
                "\t            Summary.WriteMessage(this, \"Columns missing from \" +fullFileName, MessageType.Warning); ",
                "\t        }",
                "        }",
                "",
                "        [EventSubscribe(\"PreparingNewWeatherData\")]",
                "        private void OnPreparingNewWeatherData(object sender, EventArgs e)",
                "        {",
                "                // check to see if we have a row of data for today.",
                "                int rowIndex = dates.IndexOf(clock.Today);",
                "                if (rowIndex != -1)",
                "                {",
                "                    // Yes we do have data for today so patch the data.",
                "                    foreach (DataColumn column in data.Columns)",
                "                    {",
                "                        if (column.ColumnName.Equals(\"rain\", StringComparison.InvariantCultureIgnoreCase)) {",
                "                            double val = 0;",
                "                            if (Double.TryParse(data.Rows[rowIndex][column.ColumnName].ToString(), out val)) { ",
                "                                weather.Rain = val;",
                "                            }",
                "                        } else if (column.ColumnName.Equals(\"maxt\", StringComparison.InvariantCultureIgnoreCase)) {",
                "                            double val = 0;",
                "                            if (Double.TryParse(data.Rows[rowIndex][column.ColumnName].ToString(), out val)) { ",
                "                                weather.MaxT = val;",
                "                            }",
                "                        } else if (column.ColumnName.Equals(\"mint\", StringComparison.InvariantCultureIgnoreCase)) {",
                "                            double val = 0;",
                "                            if (Double.TryParse(data.Rows[rowIndex][column.ColumnName].ToString(), out val)) { ",
                "                               weather.MinT = val;",
                "                            }",
                "                        } else if (column.ColumnName.Equals(\"radn\", StringComparison.InvariantCultureIgnoreCase)) {",
                "                            double val = 0;",
                "                            if (Double.TryParse(data.Rows[rowIndex][column.ColumnName].ToString(), out val)) { ",
                "                               weather.Radn = val; ",
                "                            }",
                "                        }",
                "                    }",
                "                }",
                "        }",
                "    }",
                "}"
              ],
              "Parameters": [],
              "Name": "LocalWeather",
              "ResourceName": null,
              "Children": [],
              "Enabled": true,
              "ReadOnly": false
            }
          ],
          "Enabled": true,
          "ReadOnly": false
        },
