                {
                  "$type": "Models.Manager, Models",
                  "CodeArray": [
                    "using Models.PMF.Phen;",
                    "using System;",
                    "using Models.Core;",
                    "using System.Collections.Generic;",
                    "using System.Text;",
                    "using Models.Soils;",
                    "using Models.PMF;",
                    "using Models;",
                    "using System.Xml.Serialization;",
                    "using APSIM.Shared.Utilities;",
                    "using APSIM.Core;",
                    "",
                    "",
                    "namespace Models",
                    "{",
                    "    [Serializable] ",
                    "    public class Script : Model, IStructureDependency",
                    "    {      ",
                    "        [Link] private Plant Lentil;",
                    "        [Link] private Clock clock;",
                    "        [Link] private Simulation sim;",
                    "        [Link] private Zone zone;",
                    "        [Link] private Phenology phenology;",
                    "        ",
                    "        private bool Harvested {get; set;}",
                    "        ",
                    "        public IStructure Structure { private get; set; }",
                    "                    ",
                    "        ",
                    "        [EventSubscribe(\"StartOfSimulation\")]",
                    "        private void OnSimulationCommencing(object sender, EventArgs e)",
                    "        {",
                    "        Harvested = false;",
                    "        }       ",
                    "        ",
                    "        [EventSubscribe(\"DoManagement\")]",
                    "        private void OnDoManagement(object sender, EventArgs e)",
                    "        {",
                    "        if ((phenology.CurrentPhase.Name==\"ReadyForHarvesting\")&&(Harvested==false))",
                    "           {",
                    "           Lentil.Harvest();",
                    "           Lentil.EndCrop();",
                    "           Harvested = true;",
                    "           Structure.Set(\"Clock.EndDate\", clock.Today, relativeTo: sim);  ",
                    "           }",
                    "        }",
                    "        ",
                    "        [EventSubscribe(\"EndOfDay\")]",
                    "        private void OnEndOfDay(object sender, EventArgs e)",
                    "        {",
                    "            if ((clock.Today.Equals(clock.EndDate))&&(Lentil.IsAlive)&&(Harvested==false))",
                    "            {",
                    "                Lentil.Harvest();",
                    "                Lentil.EndCrop();",
                    "            }",
                    "        }",
                    "    }",
                    "}",
                    "       "
                  ],
                  "Parameters": [],
                  "Name": "Harvesting",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
