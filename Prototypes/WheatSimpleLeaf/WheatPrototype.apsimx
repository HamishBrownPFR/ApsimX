                        {
                          "$type": "Models.Manager, Models",
                          "CodeArray": [
                            "using Models.Soils;",
                            "using System;",
                            "using Models.Core;",
                            "using System.Text;",
                            "using Models.PMF;",
                            "using Models;",
                            "using APSIM.Shared.Utilities;",
                            "using Models.PMF.Phen;",
                            "",
                            "namespace Models",
                            "{",
                            "    [Serializable] ",
                            "    public class Script : Model",
                            "    {",
                            "        [Link] ISummary summary;",
                            "        [Link] private Plant wheat;",
                            "        [Link(Type = LinkType.Path, Path = \"[Wheat].Phenology\")]",
                            "        private Phenology phenology;",
                            "                [Link] Clock Clock;",
                            "",
                            "        private bool Harvestable = false;",
                            "",
                            "        [Description(\"Harvest Date (d-mmm)\")]",
                            "        public string HarvestDate { get; set; }   ",
                            "      ",
                            "        [EventSubscribe(\"DoManagement\")]",
                            "        private void OnDoManagement(object sender, EventArgs e)",
                            "        {",
                            "           ",
                            "            if (Harvestable && (phenology.CurrentPhase.Name == \"GrainRipening\" || phenology.CurrentPhase.Name == \"GrainRipening\"))",
                            "            {",
                            "                wheat.Harvest();",
                            "                wheat.EndCrop();                ",
                            "            }",
                            "            ",
                            "            if (DateUtilities.DatesAreEqual(HarvestDate, Clock.Today))",
                            "                Harvestable = true;",
                            "",
                            "        }",
                            "    }",
                            "}",
                            "       "
                          ],
                          "Parameters": [
                            {
                              "Key": "HarvestDate",
                              "Value": "1-nov"
                            }
                          ],
                          "Name": "HarvestAfterDate",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
