                        },
                        {
                          "$type": "Models.Manager, Models",
                          "CodeArray": [
                            "using System;",
                            "using Models.Core;",
                            "using Models.Interfaces;",
                            "using Models.PMF;",
                            "using APSIM.Shared.Utilities;",
                            "using Models.WaterModel;",
                            "",
                            "namespace Models",
                            "{",
                            "    [Serializable]",
                            "    public class Script : Model",
                            "    {",
                            "        [Link] IClock Clock;",
                            "        [Link] ISummary Summary;",
                            "        [Link] ICanopy WheatCanopy;",
                            "        [Link] EvaporationModel EvapModel;",
                            "        ",
                            "        [Description(\"Dry soil NDVI\")]",
                            "        public double DrySoilNDVI { get; set; }",
                            "        ",
                            "        [Description(\"Wet soil NDVI\")]",
                            "        public double WetSoilNDVI { get; set; }",
                            "",
                            "        [Description(\"Green Crop NDVI\")]",
                            "        public double GreenCropNDVI { get; set; }",
                            "        ",
                            "        [Description(\"Dead Crop NDVI\")]",
                            "        public double DeadCropNDVI { get; set; }",
                            "                ",
                            "        public double NDVI { get; set; }",
                            "",
                            "        [EventSubscribe(\"DoManagement\")]",
                            "        private void DoDailyCalculations(object sender, EventArgs e)",
                            "        {",
                            "            double SoilNDVI = WetSoilNDVI;",
                            "            if (EvapModel.t > 1)",
                            "               SoilNDVI = DrySoilNDVI;",
                            "",
                            "            NDVI = GreenCropNDVI * WheatCanopy.CoverGreen;",
                            "            NDVI += DeadCropNDVI * (WheatCanopy.CoverTotal - WheatCanopy.CoverGreen);",
                            "            NDVI += SoilNDVI * (1 - WheatCanopy.CoverTotal);            ",
                            "            ",
                            "        }",
                            "    }",
                            "}",
                            ""
                          ],
                          "Parameters": [
                            {
                              "Key": "DrySoilNDVI",
                              "Value": "0.12"
                            },
                            {
                              "Key": "WetSoilNDVI",
                              "Value": "0.2"
                            },
                            {
                              "Key": "GreenCropNDVI",
                              "Value": "0.9"
                            },
                            {
                              "Key": "DeadCropNDVI",
                              "Value": "0.1"
                            }
                          ],
                          "Name": "NDVIModel",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Report, Models",
                          "VariableNames": [
                            "[Clock].Today",
                            "[NDVIModel].Script.NDVI",
                            "[Wheat].AboveGround.Wt",
                            "[Wheat].AboveGround.N",
                            "[Wheat].AboveGroundDead.Wt",
                            "[Wheat].AboveGroundDead.N",
                            "[Wheat].AboveGroundDead.NConc",
                            "[Wheat].BelowGround.N",
                            "[Wheat].TotalDead.N",
                            "[Wheat].TotalLive.N",
                            "[Wheat].Total.C",
                            "[Wheat].Total.Wt*0.4 as TotalC",
                            "[Wheat].TotalLive.Wt*0.4 as TotalLiveC",
                            "[Wheat].TotalDead.Wt*0.4 as TotalDeadC",
                            "[Wheat].Arbitrator.Nitrogen.TotalUptakeSupply",
                            "[Wheat].Arbitrator.Nitrogen.TotalReAllocationSupply",
                            "[Wheat].Arbitrator.Nitrogen.TotalReTranslocationSupply",
                            "[Wheat].Arbitrator.UnallocatedN",
