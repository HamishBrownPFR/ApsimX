                                "    {",
                                "        [Link] Weather Met;",
                                "        [Link] Clock Clock;",
                                "        [Link] Zone zone;",
                                "    ",
                                "        [Description(\"CO2 conc\")]",
                                "        public double CO2 { get; set; }",
                                "    ",
                                "        ",
                                "        [EventSubscribe(\"PreparingNewWeatherData\")]",
                                "        private void OnPreparingNewWeatherData(object sender, EventArgs e)",
                                "        {",
                                "            zone.Set(\"Weather.CO2\", CO2);",
                                "        }",
