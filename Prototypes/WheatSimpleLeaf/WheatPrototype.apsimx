                                  "Enabled": true,
                                  "Date": "1994-04-29",
                                  "Action": "[Fertiliser].Apply(amount: 200, type: \"NO3N\");",
                                  "Line": "1994-04-29 [Fertiliser].Apply(amount: 200, type: \"NO3N\");"
                                }
