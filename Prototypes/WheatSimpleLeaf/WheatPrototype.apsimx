                        {
                          "$type": "Models.Manager, Models",
                          "CodeArray": [
                            "using APSIM.Shared.Utilities;",
                            "using Models.Utilities;",
                            "using Models.Soils;",
                            "using Models.PMF;",
                            "using Models.Core;",
                            "using System;",
                            "",
                            "namespace Models",
                            "{",
                            "    [Serializable]",
                            "    public class Script : Model",
                            "    {",
                            "        [Link] Clock Clock;",
                            "        [Link] Fertiliser Fertiliser;",
                            "        [Link] Summary Summary;",
                            "        [Link] Soil Soil;",
                            "        ",
                            "        [Link] Plant wheat;",
                            "",
                            "        [Description(\"Sowing date (d-mmm)\")]",
                            "        public string SowDate { get; set; }",
                            "",
                            "        [Display(Type = DisplayType.CultivarName)]",
                            "        [Description(\"Cultivar to be sown\")]",
                            "        public string CultivarName { get; set; }",
                            "",
                            "        [Description(\"Sowing depth (mm)\")]",
                            "        public double SowingDepth { get; set; }",
                            "",
                            "        [Description(\"Row spacing (mm)\")]",
                            "        public double RowSpacing { get; set; }",
                            "",
                            "        [Description(\"Plant population (/m2)\")]",
                            "        public double Population { get; set; }",
                            "        ",
                            "        [Description(\"Emergence Date (d-MMM)\")]",
                            "        public string EmergeDate {get; set;}",
                            "",
                            "        [EventSubscribe(\"DoManagement\")]",
                            "        private void OnDoManagement(object sender, EventArgs e)",
                            "        {",
                            "            if (DateUtilities.WithinDates(SowDate, Clock.Today, SowDate))",
                            "            {",
                            "                wheat.Sow(population: Population, cultivar: CultivarName, depth: SowingDepth, rowSpacing: RowSpacing);    ",
                            "                wheat.Phenology.SetEmergenceDate(EmergeDate);",
                            "            }",
                            "        }",
                            "    }",
                            "}"
                          ],
                          "Parameters": [
                            {
                              "Key": "SowDate",
                              "Value": "24-Jul"
                            },
                            {
                              "Key": "CultivarName",
                              "Value": "Amethyst"
                            },
                            {
                              "Key": "SowingDepth",
                              "Value": "50"
                            },
                            {
                              "Key": "RowSpacing",
                              "Value": "150"
                            },
                            {
                              "Key": "Population",
                              "Value": "150"
                            },
                            {
                              "Key": "EmergeDate",
                              "Value": ""
                            }
                          ],
                          "Name": "Sowing",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Manager, Models",
                          "CodeArray": [
                            "using Models.Soils;",
                            "using System;",
                            "using Models.Core;",
                            "using Models.PMF;",
                            "namespace Models",
                            "{",
                            "    [Serializable]",
                            "    public class Script : Model",
                            "    {",
                            "        [Link] Clock Clock;",
                            "        [Link] Fertiliser Fertiliser;",
                            "        [Link] Summary Summary;",
                            "        ",
                            "        ",
                            "        [Description(\"Amount of fertiliser to be applied (kg/ha)\")]",
                            "        public double Amount { get; set;}",
                            "        ",
                            "        [Description(\"Crop to be fertilised\")]",
                            "        public string CropName { get; set;}",
                            "        ",
                            "        ",
                            "        ",
                            "",
                            "        [EventSubscribe(\"Sowing\")]",
                            "        private void OnSowing(object sender, EventArgs e)",
                            "        {",
                            "            Model crop = sender as Model;",
                            "            if (crop.Name.ToLower()==CropName.ToLower())",
                            "                Fertiliser.Apply(amount: Amount, type: \"NO3N\");",
                            "        }",
                            "        ",
                            "    }",
                            "}"
                          ],
                          "Parameters": [
                            {
                              "Key": "Amount",
                              "Value": "200"
                            },
                            {
                              "Key": "CropName",
                              "Value": "wheat"
                            }
                          ],
                          "Name": "SowingFertiliser",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Manager, Models",
                          "CodeArray": [
                            "using APSIM.Shared.Utilities;",
                            "using Models.Utilities;",
                            "using Models.Soils;",
                            "using Models.PMF;",
                            "using Models.Core;",
                            "using System;",
                            "",
                            "namespace Models",
                            "{",
                            "    [Serializable]",
                            "    public class Script : Model",
                            "    {",
                            "        [Link] Plant Wheat;",
                            "        [Link] private Clock Clock;",
                            "        [Link] private Simulation sim;",
                            "",
                            "        [EventSubscribe(\"DoManagement\")]",
                            "        private void OnDoManagement(object sender, EventArgs e)",
                            "        {",
                            "            if (Wheat.IsReadyForHarvesting)",
                            "            {",
                            "               Wheat.Harvest();",
                            "               Wheat.EndCrop();  ",
                            "               sim.Set(\"Clock.EndDate\", Clock.Today.AddDays(1));  ",
                            "            }",
                            "        ",
                            "        }",
                            "        ",
                            "    }",
                            "}"
                          ],
                          "Parameters": [],
                          "Name": "Harvesting",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Operations, Models",
                          "OperationsList": [],
                          "Name": "Management",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Irrigation, Models",
                          "Name": "Irrigation",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Manager, Models",
                          "CodeArray": [
                            "using System;",
                            "using Models.Core;",
                            "using Models.Interfaces;",
                            "using Models.PMF;",
                            "using APSIM.Shared.Utilities;",
                            "using Models.WaterModel;",
                            "",
                            "namespace Models",
                            "{",
                            "    [Serializable]",
                            "    public class Script : Model",
                            "    {",
                            "        [Link] IClock Clock;",
                            "        [Link] ISummary Summary;",
                            "        [Link] ICanopy WheatCanopy;",
                            "        [Link] EvaporationModel EvapModel;",
                            "        ",
                            "        [Description(\"Dry soil NDVI\")]",
                            "        public double DrySoilNDVI { get; set; }",
                            "        ",
                            "        [Description(\"Wet soil NDVI\")]",
                            "        public double WetSoilNDVI { get; set; }",
                            "",
                            "        [Description(\"Green Crop NDVI\")]",
                            "        public double GreenCropNDVI { get; set; }",
                            "        ",
                            "        [Description(\"Dead Crop NDVI\")]",
                            "        public double DeadCropNDVI { get; set; }",
                            "                ",
                            "        public double NDVI { get; set; }",
                            "",
                            "        [EventSubscribe(\"DoManagement\")]",
                            "        private void DoDailyCalculations(object sender, EventArgs e)",
                            "        {",
                            "            double SoilNDVI = WetSoilNDVI;",
                            "            if (EvapModel.t > 1)",
                            "               SoilNDVI = DrySoilNDVI;",
                            "",
                            "            NDVI = GreenCropNDVI * WheatCanopy.CoverGreen;",
                            "            NDVI += DeadCropNDVI * (WheatCanopy.CoverTotal - WheatCanopy.CoverGreen);",
                            "            NDVI += SoilNDVI * (1 - WheatCanopy.CoverTotal);            ",
                            "            ",
                            "        }",
                            "    }",
                            "}",
                            ""
                          ],
                          "Parameters": [
                            {
                              "Key": "DrySoilNDVI",
                              "Value": "0.12"
                            },
                            {
                              "Key": "WetSoilNDVI",
                              "Value": "0.2"
                            },
                            {
                              "Key": "GreenCropNDVI",
                              "Value": "0.9"
                            },
                            {
                              "Key": "DeadCropNDVI",
                              "Value": "0.1"
                            }
                          ],
                          "Name": "NDVIModel",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
