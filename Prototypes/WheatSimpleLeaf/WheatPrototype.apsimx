                            "//[Wheat].TotalDead.N",
                            "//[Wheat].TotalDead.NConc",
                            "//[Wheat].TotalDead.Wt",
                            "[Irrigation].IrrigationApplied",
                            "[Phenology].Photoperiod",
                            "[Soil].SoilWater.LeachNO3",
                            "[Soil].Water.Volumetric",
                            "[Soil].Water.MM",
                            "[SurfaceOrganicMatter].Wt",
                            "[Weather].MeanT",
                            "[Weather].Rain",
                            "sum([Soil].Nutrient.MineralN) as ProfileN",
                            "sum([Soil].NO3.kgha) as TotalSoilNitrogen",
                            "sum([Soil].Water.MM[1:7]) as ProfileWater",
                            "[Soil].Nutrient.MineralN",
                            "[Wheat].Grain.Live.C + [Wheat].Grain.Dead.C + [Wheat].Leaf.Live.C + [Wheat].Leaf.Dead.C + [Wheat].Root.Live.C + [Wheat].Root.Dead.C + [Wheat].Stem.Live.C + [Wheat].Stem.Dead.C as SumPlantC"
                          ],
                          "EventNames": [
                            "[Clock].EndOfDay"
                          ],
                          "GroupByVariableName": null,
                          "Name": "Report",
