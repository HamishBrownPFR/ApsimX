                        {
                          "$type": "Models.Manager, Models",
                          "CodeArray": [
                            "using Models.Interfaces;",
                            "using APSIM.Shared.Utilities;",
                            "using Models.Surface;",
                            "using Models.Soils;",
                            "using Models.PMF.OilPalm;",
                            "using Models.PMF;",
                            "using Models.Core;",
                            "using System;",
                            "using Models.Soils.Nutrients;",
                            "",
                            "namespace Models",
                            "{",
                            "    [Serializable]",
                            "    [System.Xml.Serialization.XmlInclude(typeof(Model))]",
                            "    public class Script : Model",
                            "    {",
                            "        [Link] private Clock Clock;",
                            "        [Link] private Soil Soil;",
                            "        [Link] private SurfaceOrganicMatter SurfaceOM;",
                            "        [Link]",
                            "        private ISoilWater waterBalance;",
                            "        [Description(\"Reset date\")]",
                            "        public DateTime reset_date { get; set; }",
                            "",
                            "        ",
                            "        [EventSubscribe(\"DoManagement\")]",
                            "        private void OnDoManagement(object sender, EventArgs e)",
                            "        {",
                            "            if (Clock.Today == reset_date)",
                            "                waterBalance.Reset();",
                            "        }",
                            "    }",
                            "}"
                          ],
                          "Parameters": [
                            {
                              "Key": "reset_date",
                              "Value": "09/02/1991 00:00:00"
                            }
                          ],
                          "Name": "ResetSW",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Manager, Models",
                          "CodeArray": [
                            "using Models.Soils;",
                            "using System.Xml.Serialization;",
                            "using Models;",
                            "using Models.PMF;",
                            "using System.Text;",
                            "using System.Collections.Generic;",
                            "using APSIM.Shared.Utilities;",
                            "using Models.Core;",
                            "using System;",
                            "using Models.Climate;",
                            "",
                            "namespace Models",
                            "{",
                            "    [Serializable] ",
                            "    [System.Xml.Serialization.XmlInclude(typeof(Model))]",
                            "    public class Script : Model",
                            "    {",
                            "        [Link] Weather Met;",
                            "        [Link] Clock Clock;",
                            "    ",
                            "        [Description(\"Start Date\")]",
                            "        public DateTime StartDate { get; set; }",
                            "        ",
                            "        [Description(\"End Date\")]",
                            "        public DateTime EndDate { get; set; }",
                            " ",
                            "    ",
                            "        [EventSubscribe(\"PreparingNewWeatherData\")]",
                            "        private void OnPreparingNewWeatherData(object sender, EventArgs e)",
                            "        {",
                            "            if ((Clock.Today.Date >= StartDate) && (Clock.Today.Date <= EndDate))",
                            "                Met.Rain = 0;        ",
                            "        }",
                            "    }",
                            "}"
                          ],
                          "Parameters": [
                            {
                              "Key": "StartDate",
                              "Value": "1991-06-08"
                            },
                            {
                              "Key": "EndDate",
                              "Value": "1992-12-31"
                            }
                          ],
                          "Name": "ClimateControl",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
