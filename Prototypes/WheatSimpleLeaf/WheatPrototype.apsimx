                        {
                          "$type": "Models.Manager, Models",
                          "CodeArray": [
                            "using Models.Soils;",
                            "using System.Xml.Serialization;",
                            "using Models;",
                            "using Models.PMF;",
                            "using System.Text;",
                            "using System.Collections.Generic;",
                            "using APSIM.Shared.Utilities;",
                            "using Models.Core;",
                            "using System;",
                            "using Models.Climate;",
                            "",
                            "namespace Models",
                            "{",
                            "    [Serializable] ",
                            "    [System.Xml.Serialization.XmlInclude(typeof(Model))]",
                            "    public class Script : Model",
                            "    {",
                            "        [Link] Weather Met;",
                            "        [Link] Clock Clock;",
                            "    ",
                            "        [Description(\"Start Date\")]",
                            "        public DateTime StartDate { get; set; }",
                            "        ",
                            "        [Description(\"End Date\")]",
                            "        public DateTime EndDate { get; set; }",
                            " ",
                            "    ",
                            "        [EventSubscribe(\"PreparingNewWeatherData\")]",
                            "        private void OnPreparingNewWeatherData(object sender, EventArgs e)",
                            "        {",
                            "            if ((Clock.Today.Date >= StartDate) && (Clock.Today.Date <= EndDate))",
                            "                Met.Rain = 0;        ",
                            "        }",
                            "    }",
                            "}"
                          ],
                          "Parameters": [
                            {
                              "Key": "StartDate",
                              "Value": "10/01/2015 00:00:00"
                            },
                            {
                              "Key": "EndDate",
                              "Value": "02/28/2016 00:00:00"
                            }
                          ],
                          "Name": "ClimateControl",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Manager, Models",
                          "CodeArray": [
                            "using Models.Interfaces;",
                            "using APSIM.Shared.Utilities;",
                            "using System.Xml.Serialization;",
                            "using Models;",
                            "using Models.PMF;",
                            "using Models.Soils;",
                            "using System.Text;",
                            "using System.Collections.Generic;",
                            "using Models.Core;",
                            "using System;",
                            "using Models.Soils.Nutrients;",
                            "",
                            "namespace Models",
                            "{",
                            "    [Serializable] ",
                            "    public class Script : Model",
                            "    {",
                            "        [Link] private Clock Clock;",
                            "        [Link] private Irrigation Irrigation;",
                            "        [Link] private Soil ThisSoil;",
                            "        [Link] private Zone MyZone;",
                            "        [Link]",
                            "        private IPhysical soilPhysical;",
                            "        [Link]",
                            "        private ISoilWater waterBalance;",
                            "        public string Irr { get; set; }",
                            "        public double Nit { get; set; }",
                            "        ",
                            "          ",
                            "        private void SetSoilLayers()",
                            "        {",
                            "        ",
                            "            int i = 0;",
                            "            if ((Irr == \"Nil\") && (Nit == 0))",
                            "            {",
                            "                if (soilPhysical.Thickness.Length != 7)",
                            "                {",
                            "                    throw new Exception(\"Soil layer exception\");",
                            "                }",
                            "                soilPhysical.DUL[0] = 0.31;",
                            "                soilPhysical.DUL[1] = 0.34;",
                            "                soilPhysical.DUL[2] = 0.32;",
                            "                soilPhysical.DUL[3] = 0.23;",
                            "                soilPhysical.DUL[4] = 0.29;",
                            "                soilPhysical.DUL[5] = 0.29;",
                            "                soilPhysical.DUL[6] = 0.29;",
                            "                ",
                            "                double[] nSW = { 0.18, 0.18, 0.26, 0.23, 0.29, 0.29, 0.27 };",
                            "                waterBalance.Reset();",
                            "                waterBalance.SW = nSW; ",
                            "            }   ",
                            "            if ((Irr == \"Nil\") && (Nit == 50))",
                            "            {",
                            "                if (soilPhysical.Thickness.Length != 7)",
                            "                {",
                            "                    throw new Exception(\"Soil layer exception\");",
                            "                }",
                            "                soilPhysical.DUL[0] = 0.30;",
                            "                soilPhysical.DUL[1] = 0.31;",
                            "                soilPhysical.DUL[2] = 0.29;",
                            "                soilPhysical.DUL[3] = 0.30;",
                            "                soilPhysical.DUL[4] = 0.31;",
                            "                soilPhysical.DUL[5] = 0.34;",
                            "                soilPhysical.DUL[6] = 0.30;",
                            "                ",
                            "                double[] nSW = { 0.18, 0.18, 0.30, 0.25, 0.29, 0.34, 0.30 };",
                            "                waterBalance.Reset();",
                            "                waterBalance.SW = nSW; ",
                            "            }   ",
                            "            if ((Irr == \"Nil\") && (Nit == 250))",
                            "            {",
                            "                if (soilPhysical.Thickness.Length != 7)",
                            "                {",
                            "                    throw new Exception(\"Soil layer exception\");",
                            "                }",
                            "                soilPhysical.DUL[0] = 0.28;",
                            "                soilPhysical.DUL[1] = 0.24;",
                            "                soilPhysical.DUL[2] = 0.30;",
                            "                soilPhysical.DUL[3] = 0.27;",
                            "                soilPhysical.DUL[4] = 0.28;",
                            "                soilPhysical.DUL[5] = 0.36;",
                            "                soilPhysical.DUL[6] = 0.27;",
                            "                ",
                            "                double[] nSW = { 0.18, 0.18, 0.3, 0.27, 0.28, 0.35, 0.27 };",
                            "                waterBalance.Reset();",
                            "                waterBalance.SW = nSW; ",
                            "            }   ",
                            "            if ((Irr == \"Full\") && (Nit == 0))",
                            "            {",
                            "                if (soilPhysical.Thickness.Length != 7)",
                            "                {",
                            "                    throw new Exception(\"Soil layer exception\");",
                            "                }",
                            "                soilPhysical.DUL[0] = 0.31;",
                            "                soilPhysical.DUL[1] = 0.34;",
                            "                soilPhysical.DUL[2] = 0.32;",
                            "                soilPhysical.DUL[3] = 0.23;",
                            "                soilPhysical.DUL[4] = 0.30;",
                            "                soilPhysical.DUL[5] = 0.33;",
                            "                soilPhysical.DUL[6] = 0.25;",
                            "                ",
                            "                double[] nSW = { 0.18, 0.18, 0.26, 0.20, 0.30, 0.33, 0.25 };",
                            "                waterBalance.Reset();",
                            "                waterBalance.SW = nSW; ",
                            "            }   ",
                            "            if ((Irr == \"Full\") && (Nit == 50))",
                            "            {",
                            "                if (soilPhysical.Thickness.Length != 7)",
                            "                {",
                            "                    throw new Exception(\"Soil layer exception\");",
                            "                }",
                            "                soilPhysical.DUL[0] = 0.31;",
                            "                soilPhysical.DUL[1] = 0.28;",
                            "                soilPhysical.DUL[2] = 0.30;",
                            "                soilPhysical.DUL[3] = 0.29;",
                            "                soilPhysical.DUL[4] = 0.31;",
                            "                soilPhysical.DUL[5] = 0.33;",
                            "                soilPhysical.DUL[6] = 0.30;",
                            "",
                            "                double[] nSW = { 0.18, 0.18, 0.28, 0.27, 0.28, 0.33, 0.30 };",
                            "                ",
                            "                waterBalance.Reset();",
                            "                ",
                            "                waterBalance.SW = nSW; ",
                            "",
                            "            }",
                            "            if ((Irr == \"Full\") && (Nit == 250))",
                            "            {",
                            "                if (soilPhysical.Thickness.Length != 7)",
                            "                {",
                            "                    throw new Exception(\"Soil layer exception\");",
                            "                }",
                            "                soilPhysical.DUL[0] = 0.26;",
                            "                soilPhysical.DUL[1] = 0.24;",
                            "                soilPhysical.DUL[2] = 0.26;",
                            "                soilPhysical.DUL[3] = 0.23;",
                            "                soilPhysical.DUL[4] = 0.27;",
                            "                soilPhysical.DUL[5] = 0.35;",
                            "                soilPhysical.DUL[6] = 0.22;",
                            "                ",
                            "                double[] nSW = { 0.18, 0.18, 0.24, 0.23, 0.27, 0.35, 0.22 };",
                            "                waterBalance.Reset();",
                            "                waterBalance.SW = nSW; ",
                            "            }",
                            "        }",
                            "",
                            "        [EventSubscribe(\"StartOfSimulation\")]",
                            "        private void OnSimulationCommencing(object sender, EventArgs e)",
                            "        {",
                            "            SetSoilLayers();",
                            "        }",
                            "        ",
                            "        [EventSubscribe(\"DoManagement\")]",
                            "        private void OnDoManagement(object sender, EventArgs e)",
                            "        {",
                            "            //Specify irrigations that were only applied to some of the N treatments",
                            "            if (Irr == \"Full\")",
                            "            {",
                            "                if (Nit == 250)",
                            "                {",
                            "                    if ((DateUtilities.CompareDates(\"10-Dec\", Clock.Today) == 0))",
                            "                        Irrigation.Apply(40);",
                            "                    if ((DateUtilities.CompareDates(\"17-Dec\", Clock.Today) == 0))",
                            "                        Irrigation.Apply(39.7);",
                            "                    if ((DateUtilities.CompareDates(\"14-Jan\", Clock.Today) == 0))",
                            "                        Irrigation.Apply(30);",
                            "                    if ((DateUtilities.CompareDates(\"21-Jan\", Clock.Today) == 0))",
                            "                        Irrigation.Apply(20.1);",
                            "                }",
                            "                if (Nit == 50)",
                            "                {",
                            "                    if ((DateUtilities.CompareDates(\"10-Dec\", Clock.Today) == 0))",
                            "                        Irrigation.Apply(40);",
                            "                    if ((DateUtilities.CompareDates(\"14-Jan\", Clock.Today) == 0))",
                            "                        Irrigation.Apply(30);",
                            "                }",
                            "            }",
                            "            ",
                            "        }",
                            "    }",
                            "}",
                            "    ",
