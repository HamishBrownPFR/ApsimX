                            {
                              "$type": "Models.Manager, Models",
                              "CodeArray": [
                                "using Models.Soils.Nutrients;",
                                "using System;",
                                "using Models.Core;",
                                "using Models.PMF;",
                                "using Models.Soils;",
                                "using Models.Soils.Nutrients;",
                                "using Models.Utilities;",
                                "using APSIM.Shared.Utilities;",
                                "",
                                "namespace Models",
                                "{",
                                "    [Serializable]",
                                "    public class Script : Model",
                                "    {",
                                "        [Link] Clock Clock;",
                                "        [Link] Summary Summary;",
                                "        [Link] Soil Soil;",
                                "        [Link] Plant Wheat;",
                                "        Accumulator accumulatedRain;",
                                "        ",
                                "        [Description(\"Sowing date (d-mmm)\")]",
                                "        public string SowDate { get; set; }",
                                "        [Description(\"Cultivar to be sown\")]",
                                "        public string CultivarName { get; set; }",
                                "        [Description(\"Sowing depth (mm)\")]",
                                "        public double SowingDepth { get; set; }",
                                "        [Description(\"Row spacing (mm)\")]",
                                "        public double RowSpacing { get; set; }",
                                "        [Description(\"PGR treatment applied\")]",
                                "        public string PGRTreatment { get; set; }",
                                "        ",
                                "",
                                "",
                                "        [EventSubscribe(\"DoManagement\")]",
                                "        private void OnDoManagement(object sender, EventArgs e)",
                                "        {",
                                "            if (DateUtilities.WithinDates(SowDate, Clock.Today, SowDate))",
                                "            {",
                                "                Wheat.Sow(population: 150, cultivar: CultivarName, depth: SowingDepth, rowSpacing: RowSpacing);    ",
                                "                if(SowDate == \"20-Feb\")",
                                "                {",
                                "                    Wheat.Phenology.SetEmergenceDate(\"27-Feb\");",
                                "                }",
                                "                if(SowDate == \"10-Mar\")",
                                "                {",
                                "                    Wheat.Phenology.SetEmergenceDate(\"17-Mar\");",
                                "                }",
                                "                if(SowDate == \"20-Mar\")",
                                "                {",
                                "                    Wheat.Phenology.SetEmergenceDate(\"29-Mar\");",
                                "                }",
                                "                if(SowDate == \"09-Apr\")",
                                "                {",
                                "                    Wheat.Phenology.SetEmergenceDate(\"22-Apr\");",
                                "                }",
                                "            }",
                                "        ",
                                "        }",
                                "        ",
                                "    }",
                                "}"
                              ],
                              "Parameters": [
                                {
                                  "Key": "SowDate",
                                  "Value": "24-Jul"
                                },
                                {
                                  "Key": "PGRTreatment",
                                  "Value": "0"
                                },
                                {
                                  "Key": "CultivarName",
                                  "Value": "Wakanui"
                                },
                                {
                                  "Key": "SowingDepth",
                                  "Value": "50"
                                },
                                {
                                  "Key": "RowSpacing",
                                  "Value": "150"
                                }
                              ],
                              "Name": "Sowing",
                              "ResourceName": null,
                              "Children": [],
                              "Enabled": true,
                              "ReadOnly": false
