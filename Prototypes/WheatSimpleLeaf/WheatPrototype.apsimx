        {
          "$type": "Models.Manager, Models",
          "CodeArray": [
            "using Models.Soils;",
            "using Models.PMF.Struct;",
            "using System;",
            "using System.Collections.Generic;",
            "using System.Xml.Serialization;",
            "using Models.Core;",
            "using Models.Interfaces;",
            "using Models.PMF;",
            "using Models.PMF.Organs;",
            "using Models.Soils.Arbitrator;",
            "using APSIM.Shared.Utilities;",
            "using Newtonsoft.Json;",
            "using Models.Core.Run;",
            "",
            "namespace Models",
            "{",
            "    [Serializable] ",
            "    public class Script : Model",
            "    {",
            "        public event EventHandler ReportLeafSize;",
            "        ",
            "        [Link] private Zone zone;",
            "        [Link] private Clock clock;",
            "        ",
            "        [JsonIgnore] public int NextLeafPosition { get; set; }",
            "        [JsonIgnore] public int LeafPosition { get; set; }",
            "        [JsonIgnore] public double MaxLeafSize { get; set; }",
            "        ",
            "        [EventSubscribe(\"[Wheat].Sowing\")]",
            "        private void OnSow(object sender, EventArgs e)",
            "        {",
            "        LeafPosition = 0;",
            "        NextLeafPosition = 1;",
            "        }",
            "        ",
            "        [EventSubscribe(\"DoManagement\")]",
            "        private void OnDoManagement(object sender, EventArgs e)",
            "        {",
            "            double haunStage = (double)zone.Get(\"Wheat.Leaf.HaunStage.Value()\");",
            "            double MaxLeafSize = (double)zone.Get(\"Wheat.Leaf.Canopy.GreenAreaIndex.MaxLeafSize.Value()\");",
            "            if (haunStage > NextLeafPosition) ",
            "            {",
            "                ",
            "                LeafPosition = (int)haunStage;",
            "                NextLeafPosition = LeafPosition+1;",
            "                MaxLeafSize = MaxLeafSize;",
            "                if (ReportLeafSize != null)",
            "                    ReportLeafSize.Invoke(this, new EventArgs());",
            "            }",
            "        }",
            "    }",
            "}"
          ],
          "Parameters": [],
          "Name": "OutputMaxLeafSize",
          "ResourceName": null,
          "Children": [],
          "Enabled": true,
          "ReadOnly": false
        },
        {
          "$type": "Models.Report, Models",
          "VariableNames": [
            "[OutputMaxLeafSize].Script.MaxLeafSize",
            "[OutputMaxLeafSize].Script.LeafPosition",
            "[Clock].Today"
          ],
          "EventNames": [
            "[OutputMaxLeafSize].Script.ReportLeafSize"
          ],
          "GroupByVariableName": null,
          "Name": "ReportMaxLeafSize",
          "ResourceName": null,
          "Children": [],
          "Enabled": true,
          "ReadOnly": false
        }
      ],
      "Enabled": true,
      "ReadOnly": false
    },
