                        {
                          "$type": "Models.Manager, Models",
                          "CodeArray": [
                            "using Models.Soils;",
                            "using System;",
                            "using Models.Core;",
                            "using Models.PMF;",
                            "using APSIM.Shared.Utilities;",
                            "",
                            "namespace Models",
                            "{",
                            "    [Serializable]",
                            "    public class Script : Model",
                            "    {",
                            "        [Link] Clock Clock;",
                            "        [Link] Fertiliser Fertiliser;",
                            "        [Link] Summary Summary;",
                            "        ",
                            "        [Description(\"Amount of fertiliser to be applied\")]",
                            "        public double Amount { get; set; }",
                            "",
                            "        [EventSubscribe(\"Sowing\")]",
                            "        private void OnSowing(object sender, EventArgs e)",
                            "        {",
                            "            Fertiliser.Apply(amount: Amount, type: \"NO3N\");",
                            "        }",
                            "        ",
                            "    }",
                            "}"
                          ],
                          "Parameters": [
                            {
                              "Key": "Amount",
                              "Value": "100"
                            }
                          ],
                          "Name": "SowingFertiliser",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Manager, Models",
                          "CodeArray": [
                            "",
                            "using Models.PMF.Interfaces;",
                            "using Newtonsoft.Json;",
                            "using System;",
                            "using System.Collections.Generic;",
                            "using Models.Core;",
                            "using Models.PMF;",
                            "using System.Xml.Serialization;",
                            "using Models.Soils;",
                            "",
                            "namespace Models",
                            "{",
                            "    [Serializable] ",
                            "    [System.Xml.Serialization.XmlInclude(typeof(Model))]",
                            "    public class Script : Model",
                            "    {",
                            "        [Link] Plant Wheat;",
                            "        [Link] Clock Clock;",
                            "",
                            "        [Description(\"Date that mouse damage event occurs\")]",
                            "        public DateTime NibblingDate { get; set; }",
                            "        [Description(\"Proportion of the crop removed by mice\")]",
                            "        public double ProportionNibbled { get; set; }",
                            "        ",
                            "",
                            "        ",
                            "        [EventSubscribe(\"StartOfSimulation\")]",
                            "        private void OnSimulationCommencing(object sender, EventArgs e)",
                            "        {",
                            "            ",
                            "        }",
                            "        ",
                            "        [EventSubscribe(\"DoManagement\")]",
                            "        private void OnDoManagement(object sender, EventArgs e)",
                            "        {",
                            "            //Set up  array of remove fractions to send with Cut method.  Each member in the array corresponds to an organ in the same order they are set up in.",
                            "",
                            "            if (Clock.Today.Date == NibblingDate)",
                            "            {",
                            "                //Harvest with manager specified removal fractions",
                            "                Wheat.structure?.DoThin(ProportionNibbled);",
                            "                var Grain = Wheat.FindChild<IHasDamageableBiomass>(\"Grain\");",
                            "                var Leaf = Wheat.FindChild<IHasDamageableBiomass>(\"Leaf\");",
                            "                var Stem = Wheat.FindChild<IHasDamageableBiomass>(\"Stem\");",
                            "                var Spike = Wheat.FindChild<IHasDamageableBiomass>(\"Spike\");",
                            "                var Root = Wheat.FindChild<IHasDamageableBiomass>(\"Root\");",
                            "                Grain.RemoveBiomass(liveToRemove: 0, deadToRemove: 0.0, liveToResidue: ProportionNibbled, deadToResidue: 0.0);",
                            "                Leaf.RemoveBiomass(liveToRemove: 0, deadToRemove: 0.0, liveToResidue: ProportionNibbled, deadToResidue: 0.0);",
                            "                Stem.RemoveBiomass(liveToRemove: 0, deadToRemove: 0.0, liveToResidue: ProportionNibbled, deadToResidue: 0.0);",
                            "                Spike.RemoveBiomass(liveToRemove: 0, deadToRemove: 0.0, liveToResidue: ProportionNibbled, deadToResidue: 0.0);",
                            "                Root.RemoveBiomass(liveToRemove: 0, deadToRemove: 0.0, liveToResidue: 0, deadToResidue: 0.0);",
                            "",
                            "            }",
                            "        }",
                            "    }",
                            "}",
                            "",
                            "                "
                          ],
                          "Parameters": [
                            {
                              "Key": "NibblingDate",
                              "Value": "10/31/2002 00:00:00"
                            },
                            {
                              "Key": "ProportionNibbled",
                              "Value": "0.5"
                            }
                          ],
                          "Name": "MouseActivity",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
