        {
          "$type": "Models.Core.Folder, Models",
          "ShowInDocs": true,
          "GraphsPerPage": 6,
          "Name": "Turkey",
          "ResourceName": null,
          "Children": [
            {
              "$type": "Models.Memo, Models",
              "Text": "The dataset of [Tari2016] includes 4 irrigation deficit treatments applied at each of 3 plant growth stages.  The experiment was conducted at Konya in the Central Anatolia region of Turkey. Yields ranged from 2.88 t/ha to 6.82 t/ha.  These treatments were reproduced over two growing seasons, resulting in 44 individual wheat crops including differing levels of water stress at different stages of development.  Soil data have been estimated from that provided within the original publication.",
              "Name": "Memo",
              "ResourceName": null,
              "Children": [],
              "Enabled": true,
              "ReadOnly": false
            },
