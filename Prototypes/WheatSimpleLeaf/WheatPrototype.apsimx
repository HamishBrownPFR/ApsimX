                    {
                      "$type": "Models.Core.Zone, Models",
                      "Area": 1.0,
                      "Slope": 0.0,
                      "AspectAngle": 0.0,
                      "Altitude": 50.0,
                      "Name": "paddock",
                      "ResourceName": null,
                      "Children": [
                        {
                          "$type": "Models.Core.Folder, Models",
                          "ShowInDocs": false,
                          "GraphsPerPage": 6,
                          "Name": "Manager folder",
                          "ResourceName": null,
                          "Children": [
                            {
                              "$type": "Models.Manager, Models",
                              "CodeArray": [
                                "using Models.Soils.Nutrients;",
                                "using System;",
                                "using Models.Core;",
                                "using Models.PMF;",
                                "using Models.Soils;",
                                "using Models.Soils.Nutrients;",
                                "using Models.Utilities;",
                                "using APSIM.Shared.Utilities;",
                                "",
                                "namespace Models",
                                "{",
                                "    [Serializable]",
                                "    public class Script : Model",
                                "    {",
                                "        [Link] Clock Clock;",
                                "        [Link] Summary Summary;",
                                "        [Link] Soil Soil;",
                                "        [Link] Plant Wheat;",
                                "        Accumulator accumulatedRain;",
                                "        ",
                                "        [Description(\"Sowing date (d-mmm)\")]",
                                "        public string SowDate { get; set; }",
                                "        [Description(\"Cultivar to be sown\")]",
                                "        public string CultivarName { get; set; }",
                                "        [Description(\"Sowing depth (mm)\")]",
                                "        public double SowingDepth { get; set; }",
                                "        [Description(\"Row spacing (mm)\")]",
                                "        public double RowSpacing { get; set; }",
                                "        [Description(\"Plant population (/m2)\")]",
                                "        public double Population { get; set; }",
                                "",
                                "        public bool IsSown {get;set;}",
                                "",
                                "        [EventSubscribe(\"StartOfSimulation\")]",
                                "        private void OnStartOfSimulation(object sender, EventArgs e)",
                                "        {",
                                "            IsSown = false;",
                                "        }",
                                "",
                                "        [EventSubscribe(\"DoManagement\")]",
                                "        private void OnDoManagement(object sender, EventArgs e)",
                                "        {",
                                "            if ((DateUtilities.WithinDates(SowDate, Clock.Today, SowDate))&&IsSown==false)",
                                "            {",
                                "                IsSown=true;",
                                "                Wheat.Sow(population: Population, cultivar: CultivarName, depth: SowingDepth, rowSpacing: RowSpacing);    ",
                                "                if(SowDate == \"05-Apr\")",
                                "                {",
                                "                    Wheat.Phenology.SetEmergenceDate(\"13-Apr\");",
                                "                }",
                                "                if(SowDate == \"20-Jun\")",
                                "                {",
                                "                    Wheat.Phenology.SetEmergenceDate(\"22-Jul\");",
                                "                }",
                                "                if(SowDate == \"1-Sep\")",
                                "                {",
                                "                    Wheat.Phenology.SetEmergenceDate(\"19-Sep\");",
                                "                }",
                                "                if(SowDate == \"27-Oct\")",
                                "                {",
                                "                    Wheat.Phenology.SetEmergenceDate(\"5-Nov\");",
                                "                }",
                                "                if(SowDate == \"22-Dec\")",
                                "                {",
                                "                    Wheat.Phenology.SetEmergenceDate(\"30-Dec\");",
                                "                }",
                                "              ",
                                "            }",
                                "        }",
                                "        ",
                                "    }",
                                "}"
                              ],
                              "Parameters": [
                                {
                                  "Key": "SowDate",
                                  "Value": ""
                                },
                                {
                                  "Key": "CultivarName",
                                  "Value": "Wakanui"
                                },
                                {
                                  "Key": "SowingDepth",
                                  "Value": "50"
                                },
                                {
                                  "Key": "RowSpacing",
                                  "Value": "150"
                                },
                                {
                                  "Key": "Population",
                                  "Value": "150"
                                },
                                {
                                  "Key": "IsSown",
                                  "Value": "False"
                                }
                              ],
                              "Name": "Sowing",
                              "ResourceName": null,
                              "Children": [],
                              "Enabled": true,
                              "ReadOnly": false
